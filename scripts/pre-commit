#!/usr/bin/env bash
# Pre-commit hook: runs clang-format on staged C/H files.
# Install: cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#   — or —  run: scripts/install-hooks.sh

set -euo pipefail

# Collect staged .c and .h files (excludes deleted files)
STAGED=$(git diff --cached --name-only --diff-filter=d -- '*.c' '*.h')

if [ -z "$STAGED" ]; then
    echo "ℹ️  no staged C/H files; running host tests anyway"
fi

# --- clang-format check ---
if command -v clang-format &>/dev/null; then
    UNFORMATTED=""
    for f in $STAGED; do
        if ! clang-format --dry-run --Werror "$f" &>/dev/null; then
            UNFORMATTED="$UNFORMATTED $f"
        fi
    done
    if [ -n "$UNFORMATTED" ]; then
        echo "❌ clang-format: the following files need formatting:"
        for f in $UNFORMATTED; do echo "   $f"; done
        echo ""
        echo "Run:  find components/ main/ -name '*.c' -o -name '*.h' | xargs clang-format -i"
        exit 1
    fi
else
    echo "⚠️  clang-format not found, skipping format check"
fi

if [ -f "scripts/run-host-tests.sh" ]; then
    echo "🧪 running host unit tests"
    if ! bash ./scripts/run-host-tests.sh; then
        echo "❌ host unit tests failed; commit blocked"
        exit 1
    fi
else
    echo "❌ scripts/run-host-tests.sh not found; commit blocked"
    exit 1
fi

echo "✅ pre-commit checks passed"
